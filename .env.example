# API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
FMP_API_KEY=your_fmp_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
EODHD_API_KEY=your_eodhd_api_key_here

# Intraday Data Configuration (Optional - for enhanced liquidity analysis)
# Path to directory containing 1-minute OHLCV parquet files
# Each ticker should have its own parquet file: RELIANCE.parquet, TCS.parquet, etc.
# Expected columns: datetime, open, high, low, close, volume
INTRADAY_DATA_DIR=/path/to/your/parquet/files

# Example: INTRADAY_DATA_DIR=/home/user/data/intraday
# or: INTRADAY_DATA_DIR=./data/intraday
